// Source of truth for the database.
// After editing: `npm run db:migrate -- --name what_changed`

generator client {
  provider            = "prisma-client"
  // Generated TS client lives in src/ (git-ignored, rebuilt by `prisma generate`).
  output              = "../src/generated/prisma"
  // Node native TS: generated imports must end in .ts
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
  // URL comes from prisma.config.ts (DATABASE_URL), not from here.
}

// Model = singular PascalCase (JS side). Table = plural snake_case (DB side).

model User {
  id              String    @id @default(uuid()) @db.Uuid
  // @unique = UNIQUE constraint + index. Duplicate -> Prisma error P2002.
  email           String    @unique
  name            String
  // bcrypt hash (algorithm + cost + salt + hash in one string), never the
  // password itself. Must never appear in an API response or a log —
  // the Prisma client omits it by default (src/db.ts).
  passwordHash    String    @map("password_hash")
  // null = not verified yet. A timestamp also records WHEN it happened.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  // Set automatically by Prisma on every update.
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Virtual (no column): the "many" side of User 1 -> N Workout.
  workouts      Workout[]
  refreshTokens RefreshToken[]
  emailCodes    EmailCode[]

  @@map("users")
}

model Workout {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  durationMin Int      @map("duration_min")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Foreign key: the real column, holds the owner's users.id.
  userId String @map("user_id") @db.Uuid
  // Virtual: lets code load the owner. onDelete: Cascade = deleting a user
  // deletes their workouts (account deletion must remove all their data).
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Postgres does NOT index foreign keys automatically.
  // "All workouts for user X" is our main query -> index it.
  @@index([userId])
  @@map("workouts")
}

// One row per refresh token ever issued. Rows are marked (usedAt /
// revokedAt), not deleted, so a reused old token can still be recognised.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  // SHA-256 of the token, never the token itself (like passwordHash).
  // @unique -> /auth/refresh finds the row by index.
  tokenHash String    @unique @map("token_hash")
  // Same id for every token in one login's rotation chain.
  // Reuse detected -> revoke WHERE family_id = ...
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  // Set when rotated (single use). Seen again later = reuse = theft signal.
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  // Set on logout or reuse detection.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  // Account deleted -> its tokens go too.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // logout-all: WHERE user_id = ...   family revoke: WHERE family_id = ...
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Enum = a Postgres type that only allows these values. A code issued for
// one purpose can never be used for the other.
enum EmailCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("email_code_purpose")
}

// 6-digit one-time codes sent by email. Weak alone (1,000,000 options),
// safe with: short expiry + attempt limit + single use + one active code
// per user and purpose (issuing a new one kills the old one).
model EmailCode {
  id        String           @id @default(uuid()) @db.Uuid
  purpose   EmailCodePurpose
  // SHA-256 of the code. Stops anyone just reading the table; the real
  // protection is expiry + attempts (a 6-digit hash cracks in ms).
  codeHash  String           @map("code_hash")
  // Wrong guesses so far. At the limit (5) the code is dead.
  attempts  Int              @default(0)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz
  // Set on success (single use), or when replaced by a newer code.
  usedAt    DateTime?        @map("used_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every lookup is "this user's code for this purpose".
  @@index([userId, purpose])
  @@map("email_codes")
}
