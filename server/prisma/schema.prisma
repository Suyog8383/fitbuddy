// Source of truth for the database.
// After editing: `npm run db:migrate -- --name what_changed`

generator client {
  provider = "prisma-client"
  // Generated TS client lives in src/ (git-ignored, rebuilt by `prisma generate`).
  output   = "../src/generated/prisma"
  // Node native TS: generated imports must end in .ts
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
  // URL comes from prisma.config.ts (DATABASE_URL), not from here.
}

// Model = singular PascalCase (JS side). Table = plural snake_case (DB side).
model Workout {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  durationMin Int      @map("duration_min")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("workouts")
}
