# Copy to .env ON THE SERVER ONLY, fill in, then: chmod 600 .env
# Every value here is NEW for this environment, never the laptop ones.

# Which image to run (the tag you built + shipped).
SERVER_IMAGE=fitbuddy-server:dev

# local | dev | prod. dev keeps /docs on.
APP_ENV=dev

# Public hostname. sslip.io maps 13-233-1-2.sslip.io -> 13.233.1.2.
# Use your Elastic IP with dashes instead of dots.
SITE_ADDRESS=13-233-1-2.sslip.io

# Database. Generate the password: openssl rand -hex 24
# (hex = only 0-9a-f, safe inside the connection URL).
POSTGRES_USER=fitbuddy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitbuddy

# Generate: openssl rand -base64 32
JWT_SECRET=change-me

# Resend (resend.com -> API Keys). Required: production mode sends real email.
RESEND_API_KEY=re_xxx
# EMAIL_FROM="FitBuddy <onboarding@resend.dev>"
