PORT=3000
APP_NAME=FitBuddy
NODE_ENV=development
# Which deployment: local | dev | prod (default local). Docs are off on prod.
# APP_ENV=local
# Proxies in front of the server (default 0). The deployed stack sets 1 (Caddy).
# TRUST_PROXY_HOPS=0


# Postgres (local Docker). Compose uses the POSTGRES_* vars to create the DB.
POSTGRES_USER=fitbuddy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitbuddy
DATABASE_URL=postgresql://fitbuddy:change-me@localhost:5432/fitbuddy

# Signs access tokens (JWT, HS256). Generate: openssl rand -base64 32
JWT_SECRET=change-me

# Email (Resend). Optional in development: without a key, emails are
# printed to the terminal instead. Required in production.
# Uncomment and set (resend.com -> API Keys). Never commit the real key.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="FitBuddy <onboarding@resend.dev>"
