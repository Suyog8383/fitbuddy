# Copy to .env.local (per machine, gitignored) and pick the line for
# where the app runs. EXPO_PUBLIC_* values ship INSIDE the app — anyone
# can read them. A URL is fine; never put a secret here.
#
# iOS simulator:     http://localhost:3000
# Android emulator:  http://10.0.2.2:3000
# Real phone:        http://<your Mac's Wi-Fi IP>:3000   (ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=http://localhost:3000
